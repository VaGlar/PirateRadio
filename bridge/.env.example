# Copy to .env and fill in real values before running the bridge.

# Must match <source-password> in icecast.xml
ICECAST_SOURCE_PASSWORD=changeme-source

# Icecast host/port/mount to push the live stream into
ICECAST_HOST=localhost
ICECAST_PORT=8000
ICECAST_MOUNT=/radio.webm

# Shared password broadcasters must enter on the broadcaster page
# before the bridge accepts their microphone stream.
BROADCAST_PASSWORD=changeme-broadcast

# Port the bridge's own WebSocket server listens on
BRIDGE_PORT=3001
